// Dialoge nach Calino (DESIGN.md: Modals & Panels): Abdunklung, Karte mit
// 8 px Rundung, Einblenden mit 20 px Aufwärtsbewegung in 200 ms.
// Calino: Copyright (c) 2025 Ivan Malinovski, MIT-Lizenz.

import { AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextField } from "controls.slint";
import { Segmented } from "journal-view.slint";

export global DialogLogic {
    // Unverschlüsselte Adresse? (Hinweis im Dialog)
    pure callback is-insecure(string) -> bool;
}

export component Modal inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 440px;
    // Dialoge, deren Inhalt die Höhe wechselt: oben verankert, als wäre die
    // Karte so hoch (0 = mittig nach dem Inhalt)
    in property <length> anchor-height: 0px;
    callback close();
    // Nach dem Öffnen, z. B. um das erste Feld zu fokussieren
    callback opened();

    property <bool> shown: false;
    init => {
        shown = true;
        fs.focus();
        root.opened();
    }

    background: Theme.modal-scrim;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.dur-base; }

    // Klicks auf die Abdunklung landen nicht in der Woche darunter
    TouchArea { }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            return reject;
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (root.anchor-height > 0 ? Math.max(16px, (parent.height - root.anchor-height) / 2) : (parent.height - self.height) / 2)
                + (root.shown ? 0px : 20px);
            width: Math.min(root.card-width, parent.width - 32px);
            // In kleinen Fenstern scrollt der Inhalt
            height: Math.min(content.preferred-height, parent.height - 32px);
            clip: true;
            background: Theme.modal-bg;
            border-radius: Theme.radius-md;
            border-width: Theme.dark ? 1px : 0px;
            border-color: #fff7eb14;
            drop-shadow-offset-y: 24px;
            drop-shadow-blur: 80px;
            drop-shadow-color: Theme.modal-shadow;
            animate y { duration: Theme.dur-base; easing: cubic-bezier(0.22, 1, 0.36, 1); }

            // Klicks in der Karte nicht an die Abdunklung durchreichen
            TouchArea { }

            Flickable {
                interactive: false;
                content-height: content.preferred-height;

                content := VerticalLayout {
                    width: card.width;
                    padding: 24px;
                    spacing: 18px;

                    Text {
                        text: root.title;
                        font-family: Theme.serif-medium;
                        font-size: 22px;
                        font-weight: 500;
                        color: Theme.ink;
                    }

                    @children
                }
            }
        }
    }
}

// CalDAV-Server verbinden: Adresse, Benutzer, Passwort, Name
component ServerForm inherits VerticalLayout {
    in property <bool> busy;
    in property <string> error;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> username;
    in-out property <string> password;
    callback connect(string, string, string, string);
    callback cancel();

    init => {
        url-field.focus();
    }

    function submit() {
        if !root.busy {
            root.connect(root.name, root.url, root.username, root.password);
        }
    }

    spacing: 14px;

        url-field := TextField {
            label: @tr("Server address");
            placeholder: @tr("e.g. https://calendar.example.org/dav.php");
            text <=> root.url;
            enabled: !root.busy;
            accepted => {
                user-field.focus();
            }
        }

        if DialogLogic.is-insecure(root.url): Text {
            text: @tr("Unencrypted connection (http): the password is sent in plain text. Usually fine on your own home network, otherwise use https.");
            font-size: 12px;
            color: Theme.warning-text;
            wrap: word-wrap;
        }

        user-field := TextField {
            label: @tr("Username");
            text <=> root.username;
            enabled: !root.busy;
            accepted => {
                password-field.focus();
            }
        }

        password-field := TextField {
            label: @tr("Password");
            password: true;
            text <=> root.password;
            enabled: !root.busy;
            accepted => {
                root.submit();
            }
        }

        TextField {
            label: @tr("Name in the sidebar (optional)");
            placeholder: @tr("e.g. Baïkal at home");
            text <=> root.name;
            enabled: !root.busy;
            accepted => {
                root.submit();
            }
        }

        Text {
            text: @tr("The password is stored in Windows Credential Manager, not in Hora's database.");
            font-size: 12px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }

        if root.error != "": Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.error-bg;

            VerticalLayout {
                padding: 10px;

                Text {
                    text: root.error;
                    font-size: 13px;
                    color: Theme.error;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                text: @tr("Cancel");
                enabled: !root.busy;
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: root.busy ? @tr("Connecting…") : @tr("Connect");
                primary: true;
                enabled: !root.busy;
                clicked => {
                    root.submit();
                }
            }
        }
    }

// Kalender nur auf diesem PC: Name und Farbe; beim Bearbeiten auch löschen
component LocalCalendarForm inherits VerticalLayout {
    in property <bool> editing;
    in property <string> error;
    in-out property <string> name;
    in-out property <color> color;
    callback save();
    callback delete();
    callback cancel();

    init => {
        name-field.focus();
    }

    spacing: 14px;

    name-field := TextField {
        label: @tr("Name");
        placeholder: @tr("e.g. Private");
        text <=> root.name;
        accepted => {
            root.save();
        }
    }

    VerticalLayout {
        spacing: 8px;

        Text {
            text: @tr("Color");
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink-2;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            for c[i] in Theme.calendar-colors: Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: c;
                accessible-role: button;
                accessible-label: @tr("Color {}", i + 1);
                accessible-checked: c == root.color;

                if c == root.color: Image {
                    source: @image-url("icons/check.svg");
                    width: 13px;
                    height: 13px;
                    colorize: #ffffff;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.color = c;
                    }
                }
            }
        }
    }

    Text {
        text: @tr("Events, tasks and journal entries in this calendar stay on this PC only: no sync with other devices and no backup on a server.");
        font-size: 12px;
        color: Theme.ink-3;
        wrap: word-wrap;
    }

    if root.error != "": Rectangle {
        border-radius: Theme.radius-sm;
        background: Theme.error-bg;

        VerticalLayout {
            padding: 10px;

            Text {
                text: root.error;
                font-size: 13px;
                color: Theme.error;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;

        if root.editing: Button {
            text: @tr("Delete");
            danger: true;
            clicked => {
                root.delete();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Button {
            text: @tr("Cancel");
            clicked => {
                root.cancel();
            }
        }

        Button {
            text: root.editing ? @tr("Save") : @tr("Create");
            primary: true;
            clicked => {
                root.save();
            }
        }
    }
}

// Kalender hinzufügen: nur auf diesem PC oder von einem CalDAV-Server;
// lokale Kalender auch bearbeiten
export component AddAccountDialog inherits Modal {
    in property <bool> busy;
    in property <string> error;
    in-out property <string> name;
    in-out property <string> url;
    in-out property <string> username;
    in-out property <string> password;
    // 0 = auf diesem PC, 1 = CalDAV-Server
    in-out property <int> mode;
    // Lokalen Kalender bearbeiten statt anlegen
    in property <bool> editing;
    in-out property <string> calendar-name;
    in-out property <color> calendar-color;
    callback connect(string, string, string, string);
    callback save-local();
    callback delete-local();
    callback cancel();

    title: root.editing ? @tr("Edit calendar") : @tr("Add calendar");
    card-width: 480px;
    // Der Umschalter bleibt beim Wechsel an seiner Stelle
    anchor-height: 530px;
    close => {
        if !root.busy {
            root.cancel();
        }
    }

    VerticalLayout {
        spacing: 16px;

        if !root.editing: Segmented {
            labels: [@tr("On this PC"), @tr("CalDAV server")];
            current: root.mode;
            tab-w: 212px;
            select(i) => {
                if !root.busy {
                    root.mode = i;
                }
            }
        }

        if root.editing || root.mode == 0: LocalCalendarForm {
            editing: root.editing;
            error: root.error;
            name <=> root.calendar-name;
            color <=> root.calendar-color;
            save => {
                root.save-local();
            }
            delete => {
                root.delete-local();
            }
            cancel => {
                root.cancel();
            }
        }

        if !root.editing && root.mode == 1: ServerForm {
            busy: root.busy;
            error: root.error;
            name <=> root.name;
            url <=> root.url;
            username <=> root.username;
            password <=> root.password;
            connect(n, u, user, pw) => {
                root.connect(n, u, user, pw);
            }
            cancel => {
                root.cancel();
            }
        }
    }
}

export component AboutDialog inherits Modal {
    in property <string> version;
    callback dismiss();

    title: "Hora";
    close => {
        root.dismiss();
    }

    VerticalLayout {
        spacing: 12px;

        Text {
            text: @tr("Version {} · Desktop calendar for Windows, inspired by Calino", root.version);
            font-size: 14px;
            color: Theme.ink-2;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Design and behavior based on Calino by Ivan Malinovski (MIT License), github.com/Ivan-Malinovski/calino. Hora is an independent project, not an official Calino app.");
            font-size: 13px;
            color: Theme.ink-2;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Font: Newsreader, The Newsreader Project Authors (SIL Open Font License 1.1).");
            font-size: 13px;
            color: Theme.ink-2;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;

            AboutSlint {
                preferred-height: 140px;
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Close");
                primary: true;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
