// Einstellungen: Erinnerungen und Programmverhalten. Zeilen mit Titel,
// Beschreibung und Schalter wie Calinos Einstellungsseiten
// (NotificationSettings.tsx, GeneralSettings.tsx).
// Calino: Copyright (c) 2025 Ivan Malinovski, MIT-Lizenz.

import { Theme, Fmt } from "theme.slint";
import { Button, FocusRing } from "controls.slint";
import { Select, SelectOption } from "inputs.slint";
import { Modal } from "dialogs.slint";

// Schalter (Calino: toggle)
export component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled();

    width: 38px;
    height: 22px;
    border-radius: 11px;
    forward-focus: fs;
    background: root.checked ? Theme.accent : Theme.ink-4;
    animate background { duration: Theme.dur-fast; }
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.flip();
    }

    function flip() {
        root.checked = !root.checked;
        root.toggled();
    }

    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000033;
        animate x { duration: Theme.dur-fast; easing: ease-out; }
    }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            fs.focus();
            root.flip();
        }
    }

    if fs.has-focus: FocusRing {
        radius: 11px;
        w: root.width;
        h: root.height;
    }
}

// Überschrift einer Gruppe, wie "KALENDER" in der Seitenleiste
component GroupLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.9px;
    color: Theme.ink-3;
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;

    spacing: 16px;
    padding-top: 10px;
    padding-bottom: 10px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 14px;
            color: Theme.ink;
        }

        Text {
            text: root.description;
            font-size: 12px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;

        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line-2;
}

// Aktivität der App-Zeiten: Farbe, Name, Programme und gezählte Zeit
export struct ActivityRow {
    id: int,
    name: string,
    color: color,
    detail: string,
}

export component SettingsDialog inherits Modal {
    in-out property <bool> reminders;
    in-out property <int> default-reminder;
    in-out property <bool> autostart;
    in-out property <bool> keep-running;
    in-out property <bool> show-tasks;
    in-out property <bool> task-reminders;
    in property <[SelectOption]> default-reminder-options;
    in-out property <int> language;
    in property <[SelectOption]> language-options;
    callback language-changed();
    in-out property <int> formats;
    in property <[SelectOption]> format-options;
    callback formats-changed();
    // Zustand der Windows-Benachrichtigungen, z. B. "ausgeschaltet"
    in property <string> status;
    callback changed();
    callback test-notification();
    // App-Zeiten: eingeschaltet, über den Infobereich pausiert, Aktivitäten
    in-out property <bool> activities;
    in property <bool> activities-paused;
    in property <[ActivityRow]> activity-rows;
    // Ein Dialog darüber ist offen; danach den Fokus zurückholen
    in property <bool> covered;
    callback activity-new();
    callback activity-edit(int);
    in-out property <bool> update-check;
    in property <string> version;
    // Version, die zum Installieren bereitliegt ("" = keine)
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-busy;
    // Nur eine mit Hora Setup installierte Kopie aktualisiert sich
    in property <bool> update-possible;
    callback check-updates();
    callback install-update();
    callback dismiss();

    title: @tr("Settings");
    card-width: 540px;
    close => {
        root.dismiss();
    }
    opened => {
        first.focus();
    }
    changed covered => {
        if !self.covered {
            first.focus();
        }
    }

    VerticalLayout {
        spacing: 0px;

        GroupLabel {
            text: @tr("REMINDERS");
        }

        Row {
            label: @tr("Event reminders");
            description: @tr("Windows notification before events start, even when Hora is in the notification area");

            first := Toggle {
                label: @tr("Event reminders");
                checked <=> root.reminders;
                toggled => {
                    root.changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Default reminder");
            description: @tr("Reminder that new events start with");

            Select {
                label: "";
                dots: false;
                width: 210px;
                options: root.default-reminder-options;
                selected <=> root.default-reminder;
                changed selected => {
                    root.changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Task due reminders");
            description: @tr("Notify when a task is due: at the due time, or at {} for tasks with only a date", Fmt.hhmm(540));

            Toggle {
                label: @tr("Task due reminders");
                checked <=> root.task-reminders;
                toggled => {
                    root.changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Test notification");
            description: root.status != "" ? root.status : @tr("Shows a notification right away to check Windows settings and sound");

            Button {
                text: @tr("Send");
                clicked => {
                    root.test-notification();
                }
            }
        }

        Rectangle {
            height: 22px;
        }

        GroupLabel {
            text: @tr("TASKS");
        }

        Row {
            label: @tr("Show tasks in the calendar");
            description: @tr("Open tasks appear in the week and month views on their due date");

            Toggle {
                label: @tr("Show tasks in the calendar");
                checked <=> root.show-tasks;
                toggled => {
                    root.changed();
                }
            }
        }

        Rectangle {
            height: 22px;
        }

        GroupLabel {
            text: @tr("APP TIME");
        }

        Row {
            label: @tr("Count app time");
            description: root.activities-paused
                ? @tr("Paused. Resume in the menu of the Hora icon in the notification area.")
                : @tr("Counts how long you actively use the programs of an activity: while one of them is in front and you use the mouse, keyboard or pen. The times stay on this PC.");

            Toggle {
                label: @tr("Count app time");
                checked <=> root.activities;
                toggled => {
                    root.changed();
                }
            }
        }

        if root.activities: VerticalLayout {
            for row in root.activity-rows: VerticalLayout {
                Divider { }

                HorizontalLayout {
                    spacing: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: row.color;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: row.name;
                            font-size: 14px;
                            color: Theme.ink;
                            overflow: elide;
                        }

                        Text {
                            text: row.detail;
                            font-size: 12px;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: @tr("Edit");
                            clicked => {
                                root.activity-edit(row.id);
                            }
                        }
                    }
                }
            }

            Divider { }

            HorizontalLayout {
                padding-top: 12px;
                alignment: start;

                Button {
                    text: @tr("New activity…");
                    clicked => {
                        root.activity-new();
                    }
                }
            }
        }

        Rectangle {
            height: 22px;
        }

        GroupLabel {
            text: @tr("GENERAL");
        }

        Row {
            label: @tr("Language");
            description: @tr("Language of menus, dates and notifications");

            Select {
                label: "";
                dots: false;
                width: 210px;
                options: root.language-options;
                selected <=> root.language;
                changed selected => {
                    root.language-changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Date and time format");
            description: @tr("Order of day, month and year; 12 or 24 hours");

            Select {
                label: "";
                dots: false;
                width: 250px;
                options: root.format-options;
                selected <=> root.formats;
                changed selected => {
                    root.formats-changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Start with Windows");
            description: @tr("Hora starts quietly in the notification area when you sign in");

            Toggle {
                label: @tr("Start with Windows");
                checked <=> root.autostart;
                toggled => {
                    root.changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Keep running in the notification area");
            description: @tr("Closing the window doesn't quit Hora, so reminders and sync keep running");

            Toggle {
                label: @tr("Keep running in the notification area");
                checked <=> root.keep-running;
                toggled => {
                    root.changed();
                }
            }
        }

        Rectangle {
            height: 22px;
        }

        GroupLabel {
            text: @tr("UPDATES");
        }

        Row {
            label: @tr("Check for updates automatically");
            description: @tr("Once a day Hora looks for a new version on GitHub and downloads it in the background. It installs only when you restart Hora.");

            Toggle {
                label: @tr("Check for updates automatically");
                checked <=> root.update-check;
                toggled => {
                    root.changed();
                }
            }
        }

        Divider { }

        Row {
            label: @tr("Hora {}", root.version);
            description: root.update-status;

            Button {
                text: root.update-version != "" ? @tr("Restart and update") : @tr("Check now");
                primary: root.update-version != "";
                enabled: root.update-possible && !root.update-busy;
                clicked => {
                    if root.update-version != "" {
                        root.install-update();
                    } else {
                        root.check-updates();
                    }
                }
            }
        }

        Rectangle {
            height: 18px;
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Done");
                primary: true;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
