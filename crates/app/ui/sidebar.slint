// Seitenleiste mit Kalenderliste nach Calino (Sidebar.module.css).
// Calino: Copyright (c) 2025 Ivan Malinovski, MIT-Lizenz.

import { Theme, Locale } from "theme.slint";
import { Button, IconButton } from "controls.slint";

export struct CalendarRow {
    // -1 = Beispieltermine auf diesem Gerät
    id: int,
    account: string,
    name: string,
    color: color,
    visible: bool,
    read-only: bool,
    // Kontoname über dieser Zeile anzeigen
    first-of-account: bool,
}

export struct MiniDay {
    number: string,
    today: bool,
    other-month: bool,
    selected: bool,
}

// Mini-Kalender nach Calino (.mini …): Karte, Monat in Newsreader, 6 Wochen
component MiniCalendar inherits Rectangle {
    in property <string> month;
    in property <string> year;
    in property <[MiniDay]> days;
    callback prev();
    callback next();
    callback pick(int);

    property <length> cell: (root.width - 32px) / 7;

    height: layout.preferred-height;
    background: Theme.panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-offset-y: 2px;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.dark ? transparent : #0000000a;

    layout := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 16px;
        padding-bottom: 18px;
        spacing: 0px;

        HorizontalLayout {
            height: 28px;
            spacing: 6px;

            Text {
                text: root.month;
                font-family: Theme.serif-medium;
                font-size: 20px;
                font-weight: 500;
                color: Theme.ink;
                vertical-alignment: center;
            }

            Text {
                text: root.year;
                font-size: 16px;
                color: Theme.ink-3;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            IconButton {
                icon: @image-url("icons/chevron-left.svg");
                label: @tr("Previous month");
                icon-size: 14px;
                clicked => {
                    root.prev();
                }
            }

            IconButton {
                icon: @image-url("icons/chevron-right.svg");
                label: @tr("Next month");
                icon-size: 14px;
                clicked => {
                    root.next();
                }
            }
        }

        Rectangle {
            height: 16px;
        }

        HorizontalLayout {
            for name in Locale.weekday-letter: Text {
                width: root.cell;
                text: name;
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 0.4px;
                color: Theme.ink-3;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            height: 8px;
        }

        Rectangle {
            height: 6 * root.cell;

            for day[i] in root.days: Rectangle {
                x: Math.mod(i, 7) * root.cell;
                y: Math.floor(i / 7) * root.cell;
                width: root.cell;
                height: root.cell;
                border-radius: Theme.radius-sm;
                background: day.selected ? Theme.accent-strong : day-ta.has-hover ? Theme.hover-bg : transparent;
                accessible-role: button;
                accessible-label: day.number;

                Text {
                    text: day.number;
                    font-size: 12.5px;
                    font-weight: day.selected || day.today ? 600 : 400;
                    color: day.selected ? Theme.accent-contrast : day.today ? Theme.accent-strong : day.other-month ? Theme.ink-3 : Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                day-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.pick(i);
                    }
                }
            }
        }
    }
}

component CalendarItem inherits Rectangle {
    in property <CalendarRow> cal;
    callback toggle();
    callback pick-color(length);

    height: 32px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.ink-raw.with-alpha(0.04) : transparent;
    accessible-role: checkbox;
    accessible-label: root.cal.name;
    accessible-checkable: true;
    accessible-checked: root.cal.visible;
    animate background { duration: Theme.dur-fast; }

    // FocusScope vor der TouchArea, sonst nimmt er den ersten Klick
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            fs.focus();
            root.toggle();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        // Kontrollkästchen in der Kalenderfarbe
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: root.cal.color;
                background: root.cal.visible ? root.cal.color : transparent;
                animate background { duration: Theme.dur-fast; }

                if root.cal.visible: Image {
                    source: @image-url("icons/check.svg");
                    width: 11px;
                    height: 11px;
                    colorize: #ffffff;
                }
            }
        }

        Text {
            text: root.cal.name;
            font-size: 14px;
            color: root.cal.visible ? Theme.ink : Theme.ink-3;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.cal.read-only: Text {
            text: @tr("read-only");
            font-size: 11px;
            color: Theme.ink-3;
            vertical-alignment: center;
        }

        // Farbpunkt öffnet die Farbauswahl
        if root.cal.id >= 0: VerticalLayout {
            alignment: center;

            dot := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: dot-ta.has-hover ? Theme.ink-raw.with-alpha(0.08) : transparent;
                accessible-role: button;
                accessible-label: @tr("Color for {}", root.cal.name);

                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.cal.color;
                }

                dot-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.pick-color(root.y + root.height);
                    }
                }
            }
        }
    }

    if fs.has-focus: Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// Textverweis unten in der Seitenleiste, auch per Tab und Eingabe erreichbar
component FooterLink inherits Text {
    callback clicked();

    font-size: 13px;
    color: ta.has-hover || fs.has-focus ? Theme.ink : Theme.ink-3;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => {
        root.clicked();
    }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[CalendarRow]> calendars;
    in property <bool> has-accounts;
    in property <string> mini-month;
    in property <string> mini-year;
    in property <[MiniDay]> mini-days;
    callback toggle(int);
    callback set-color(int, color);
    callback add-account();
    callback about();
    callback settings();
    callback mini-prev();
    callback mini-next();
    callback mini-pick(int);

    property <int> picker-id: -1;
    property <length> picker-y;

    width: Theme.sidebar-width;
    background: Theme.canvas;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 4px;
        padding-bottom: 20px;
        spacing: 8px;

        MiniCalendar {
            month: root.mini-month;
            year: root.mini-year;
            days: root.mini-days;
            prev => {
                root.mini-prev();
            }
            next => {
                root.mini-next();
            }
            pick(i) => {
                root.mini-pick(i);
            }
        }

        Rectangle {
            height: 8px;
        }

        HorizontalLayout {
            height: 28px;

            Text {
                text: @tr("CALENDARS");
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: 1.03px;
                color: Theme.ink-3;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: @image-url("icons/plus.svg");
                    label: @tr("Add account");
                    clicked => {
                        root.add-account();
                    }
                }
            }
        }

        list := VerticalLayout {
            spacing: 0px;

            for row in root.calendars: VerticalLayout {
                spacing: 0px;

                if row.first-of-account: Text {
                    text: row.account;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.ink-2;
                    height: 28px;
                    vertical-alignment: bottom;
                    overflow: elide;
                }

                CalendarItem {
                    cal: row;
                    toggle => {
                        root.toggle(row.id);
                    }
                    pick-color(bottom) => {
                        root.picker-id = row.id;
                        root.picker-y = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                        picker.show();
                    }
                }
            }
        }

        if !root.has-accounts: Rectangle {
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: @tr("Connect your CalDAV server to see your own events.");
                    font-size: 13px;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    Button {
                        text: @tr("Add account");
                        primary: true;
                        clicked => {
                            root.add-account();
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 18px;

            FooterLink {
                text: @tr("Settings");
                clicked => {
                    root.settings();
                }
            }

            FooterLink {
                text: @tr("About Hora");
                clicked => {
                    root.about();
                }
            }
        }
    }

    picker := PopupWindow {
        x: 20px;
        y: root.picker-y;
        width: 6 * 28px + 16px;
        height: 2 * 28px + 16px;

        Rectangle {
            background: Theme.popover-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.popover-border;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.dark ? transparent : #0000001a;

            for c[i] in Theme.calendar-colors: Rectangle {
                x: 8px + Math.mod(i, 6) * 28px + 3px;
                y: 8px + Math.floor(i / 6) * 28px + 3px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: c;
                border-width: swatch-ta.has-hover ? 2px : 0px;
                border-color: Theme.popover-bg;
                accessible-role: button;
                accessible-label: @tr("Color {}", i + 1);

                swatch-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.set-color(root.picker-id, c);
                    }
                }
            }
        }
    }
}
