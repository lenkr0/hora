// App-Zeiten als eigener Bereich: links die Aktivitäten mit der Zeit dieser
// Woche, rechts die gewählte mit Summen, Verlauf über Wochen oder Monate und
// den letzten Sitzungen.

import { Theme } from "theme.slint";
import { Button } from "controls.slint";
import { Segmented } from "journal-view.slint";
import { ActivityRow } from "settings.slint";

// Balken im Verlauf: Beschriftung darunter, Zeitraum und Wert für den
// Hinweis, Höhe 0–1 (bezogen auf die oberste Linie)
export struct ActivityBar {
    label: string,
    title: string,
    text: string,
    value: float,
    current: bool,
}

// Sitzung: Tag, Uhrzeit von–bis, gezählte Zeit
export struct ActivitySession {
    day: string,
    span: string,
    length: string,
}

// Zahlen der gewählten Aktivität
export struct ActivityStats {
    color: color,
    total: string,
    since: string,
    week: string,
    week-range: string,
    month: string,
    month-name: string,
    // Beschriftung der obersten und mittleren Linie im Verlauf
    scale-top: string,
    scale-mid: string,
    // Wochenziel als Linie im Verlauf (0–1); negativ = keins
    goal: float,
    goal-label: string,
    // z. B. "Ziel 3 Wochen in Folge erreicht"
    streak: string,
    bars: [ActivityBar],
    summary: string,
    sessions: [ActivitySession],
}

component SectionLabel inherits Text {
    font-size: 13px;
    font-weight: 500;
    color: Theme.ink-2;
}

// Kachel mit einer großen Zahl
component Tile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> note;

    // Alle Kacheln gleich breit, unabhängig von der Länge der Zahl
    preferred-width: 1px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.line;
    accessible-role: text;
    accessible-label: root.label + ": " + root.value;

    VerticalLayout {
        padding: 14px;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.ink-3;
            overflow: elide;
        }

        Text {
            text: root.value;
            font-family: Theme.serif-medium;
            font-size: 24px;
            color: Theme.ink;
            overflow: elide;
        }

        Text {
            text: root.note;
            font-size: 12px;
            color: Theme.ink-3;
            overflow: elide;
        }
    }
}

// Säulen in der Farbe der Aktivität; Linien und Schrift bleiben zurückhaltend
component Chart inherits Rectangle {
    in property <[ActivityBar]> bars;
    in property <color> bar-color;
    in property <string> scale-top;
    in property <string> scale-mid;
    in property <float> goal: -1;
    in property <string> goal-label;

    // Platz über der obersten Linie für den Hinweis
    property <length> top-pad: 30px;
    property <length> plot-h: 140px;
    property <length> gutter: 44px;
    // Rechts Platz für die Beschriftung der Ziellinie
    property <length> right-gutter: root.goal >= 0 ? goal-text.preferred-width + 10px : 0px;
    property <length> plot-w: root.width - root.gutter - root.right-gutter;
    property <length> slot: root.plot-w / Math.max(1, root.bars.length);
    property <length> bar-w: Math.max(6px, Math.min(26px, root.slot - 12px));
    property <int> hovered: -1;

    height: root.top-pad + root.plot-h + 26px;

    for line[i] in [
        { y: root.top-pad, text: root.scale-top },
        { y: root.top-pad + root.plot-h / 2, text: root.scale-mid },
        { y: root.top-pad + root.plot-h, text: "" },
    ]: Rectangle {
        y: line.y;
        height: 1px;

        Rectangle {
            x: root.gutter;
            width: root.plot-w;
            height: 1px;
            background: i == 2 ? Theme.line : Theme.line-2;
        }

        Text {
            x: 0;
            y: -7px;
            width: root.gutter - 10px;
            height: 14px;
            text: line.text;
            font-size: 11px;
            color: Theme.ink-3;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    for bar[i] in root.bars: Rectangle {
        x: root.gutter + i * root.slot;
        width: root.slot;
        height: root.height;
        accessible-role: list-item;
        accessible-label: bar.title + ": " + bar.text;

        if bar.value > 0: Rectangle {
            x: (parent.width - root.bar-w) / 2;
            width: root.bar-w;
            height: Math.max(2px, Math.min(1, bar.value) * root.plot-h);
            y: root.top-pad + root.plot-h - self.height;
            border-radius: Math.min(4px, self.height / 2);
            background: slot-ta.has-hover ? root.bar-color.darker(0.15) : root.bar-color;

            // Unten eckig: Die Säule steht auf der Grundlinie
            Rectangle {
                y: parent.height - self.height;
                height: Math.min(parent.height / 2, 4px);
                background: parent.background;
            }
        }

        Text {
            y: root.top-pad + root.plot-h + 7px;
            // Ist nur jede zweite beschriftet, darf sie in die leeren Nachbarn reichen
            width: root.slot >= 52px ? parent.width : parent.width * 2;
            x: (parent.width - self.width) / 2;
            // Wird es eng, nur jede zweite Beschriftung, von der laufenden aus
            text: root.slot >= 52px || Math.mod(root.bars.length - 1 - i, 2) == 0 ? bar.label : "";
            font-size: 11px;
            font-weight: bar.current ? 600 : 400;
            color: bar.current ? Theme.ink : Theme.ink-3;
            horizontal-alignment: center;
            overflow: elide;
        }

        slot-ta := TouchArea {
            changed has-hover => {
                if self.has-hover {
                    root.hovered = i;
                } else if root.hovered == i {
                    root.hovered = -1;
                }
            }
        }
    }

    // Wochenziel: Linie in Textfarbe über den Säulen, rechts daneben beschriftet
    property <length> goal-y: root.top-pad + root.plot-h - Math.min(1, Math.max(0, root.goal)) * root.plot-h;

    if root.goal >= 0: Rectangle {
        x: root.gutter;
        y: root.goal-y;
        width: root.plot-w;
        height: 1px;
        background: Theme.ink-2;
        accessible-role: text;
        accessible-label: root.goal-label;
    }

    goal-text := Text {
        visible: root.goal >= 0;
        x: root.width - self.preferred-width;
        y: root.goal-y - 7px;
        height: 14px;
        text: root.goal-label;
        font-size: 11px;
        color: Theme.ink-2;
        vertical-alignment: center;
    }

    if root.hovered >= 0 && root.hovered < root.bars.length: Rectangle {
        property <ActivityBar> bar: root.bars[root.hovered];
        property <length> top: root.top-pad + root.plot-h - Math.min(1, self.bar.value) * root.plot-h;

        width: tip.preferred-width + 20px;
        height: 26px;
        x: Math.max(0px, Math.min(root.width - self.width, root.gutter + (root.hovered + 0.5) * root.slot - self.width / 2));
        z: 1;
        y: Math.max(0px, self.top - self.height - 6px);
        border-radius: 6px;
        background: Theme.popover-bg;
        border-width: 1px;
        border-color: Theme.popover-border;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.dark ? transparent : #0000001a;

        tip := Text {
            text: parent.bar.title + " · " + parent.bar.text;
            font-size: 12px;
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Aktivität in der Liste links: Farbe, Name, Zeit dieser Woche, Wochenziel
component ActivityCard inherits Rectangle {
    in property <ActivityRow> item;
    in property <bool> selected;
    callback clicked();

    height: 58px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.panel : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.line;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.detail;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    // Vor der TouchArea, damit der erste Klick zählt
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.item.color;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.name;
                font-size: 14px;
                font-weight: 500;
                color: Theme.ink;
                overflow: elide;
            }

            Text {
                text: root.item.detail;
                font-size: 12.5px;
                color: Theme.ink-3;
                overflow: elide;
            }
        }

        if root.item.progress >= 1: VerticalLayout {
            alignment: center;

            Image {
                source: @image-url("icons/check.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.success;
                accessible-role: image;
                accessible-label: @tr("Weekly goal reached");
            }
        }
    }

    // Wochenziel: schmaler Balken unten
    if root.item.progress >= 0: Rectangle {
        x: 36px;
        y: root.height - 9px;
        width: root.width - 50px;
        height: 2px;
        border-radius: 1px;
        background: Theme.line;

        Rectangle {
            x: 0;
            width: parent.width * Math.min(1, root.item.progress);
            height: parent.height;
            border-radius: 1px;
            background: root.item.color;
        }
    }

    if fs.has-focus: Rectangle {
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

export component ActivityPage inherits Rectangle {
    // Aktivitäten wie in der Seitenleiste; gewählt ist die mit dieser Kennung
    in property <[ActivityRow]> rows;
    in property <int> selected;
    in property <ActivityStats> stats;
    // Name, Programme und Pause der gewählten Aktivität
    in property <string> name;
    in property <string> programs;
    // "3 Aktivitäten · diese Woche 7:57 Std."
    in property <string> head;
    // Über den Infobereich pausiert
    in property <bool> paused;
    in-out property <bool> months;
    callback select(int);
    callback range-changed();
    callback new-activity();
    callback edit(int);

    background: Theme.canvas;

    // Spalte höchstens 1000 px breit, mittig
    Rectangle {
        x: (root.width - self.width) / 2;
        width: Math.min(1000px, root.width - 24px);
        height: root.height;

        VerticalLayout {
            padding-top: 4px;
            spacing: 0px;

            // Leiste: Zahl und Woche links, Anlegen rechts
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 14px;
                spacing: 14px;

                Text {
                    text: root.head;
                    font-size: 14px;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Button {
                    text: @tr("+ New activity");
                    primary: true;
                    clicked => {
                        root.new-activity();
                    }
                }
            }

            if root.paused: Rectangle {
                height: 40px;

                Rectangle {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 34px;
                    y: 0px;
                    border-radius: Theme.radius-md;
                    background: Theme.selected-bg;

                    Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: @tr("Paused. Resume in the menu of the Hora icon in the notification area.");
                        font-size: 13px;
                        color: Theme.ink-2;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // Noch keine Aktivität
            if root.rows.length == 0: VerticalLayout {
                padding: 14px;
                padding-top: 40px;
                spacing: 14px;
                alignment: start;

                Text {
                    text: @tr("No activities yet. Create one and choose the programs whose time Hora should count.");
                    font-size: 14px;
                    color: Theme.ink-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.rows.length > 0: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 20px;

                // Liste
                VerticalLayout {
                    width: 270px;
                    spacing: 4px;
                    alignment: start;

                    for row in root.rows: ActivityCard {
                        item: row;
                        selected: row.id == root.selected;
                        clicked => {
                            root.select(row.id);
                        }
                    }
                }

                // Übersicht der gewählten Aktivität
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.panel;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.line;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;

                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: root.stats.color;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.name;
                                    font-family: Theme.serif-medium;
                                    font-size: 21px;
                                    color: Theme.ink;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.programs;
                                    font-size: 12.5px;
                                    color: Theme.ink-3;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Button {
                                    text: @tr("Edit");
                                    clicked => {
                                        root.edit(root.selected);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            Tile {
                                label: @tr("Total");
                                value: root.stats.total;
                                note: root.stats.since;
                            }

                            Tile {
                                label: @tr("This week");
                                value: root.stats.week;
                                note: root.stats.week-range;
                            }

                            Tile {
                                label: @tr("This month");
                                value: root.stats.month;
                                note: root.stats.month-name;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 12px;

                                SectionLabel {
                                    text: @tr("History");
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.stats.streak;
                                    font-size: 12px;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Segmented {
                                    labels: [@tr("Weeks"), @tr("Months")];
                                    current: root.months ? 1 : 0;
                                    tab-w: 84px;
                                    tab-h: 26px;
                                    font-px: 12.5px;
                                    select(i) => {
                                        root.months = i == 1;
                                        root.range-changed();
                                    }
                                }
                            }

                            Chart {
                                bars: root.stats.bars;
                                bar-color: root.stats.color;
                                scale-top: root.stats.scale-top;
                                scale-mid: root.stats.scale-mid;
                                goal: root.stats.goal;
                                goal-label: root.stats.goal-label;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 12px;

                                SectionLabel {
                                    text: @tr("Sessions");
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.stats.summary;
                                    font-size: 12px;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                }
                            }

                            if root.stats.sessions.length == 0: Text {
                                text: @tr("No sessions yet. They appear here once you use a program of this activity.");
                                font-size: 13px;
                                color: Theme.ink-3;
                                wrap: word-wrap;
                            }

                            if root.stats.sessions.length > 0: Flickable {
                                vertical-stretch: 1;
                                min-height: 60px;
                                content-height: list.preferred-height;

                                list := VerticalLayout {
                                    alignment: start;

                                    for session in root.stats.sessions: VerticalLayout {
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.line-2;
                                        }

                                        HorizontalLayout {
                                            padding-top: 7px;
                                            padding-bottom: 7px;
                                            spacing: 12px;

                                            Text {
                                                text: session.day;
                                                font-size: 13px;
                                                color: Theme.ink;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: session.span;
                                                font-size: 13px;
                                                color: Theme.ink-3;
                                            }

                                            Text {
                                                min-width: 64px;
                                                text: session.length;
                                                font-size: 13px;
                                                color: Theme.ink;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.rows.length == 0: Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
