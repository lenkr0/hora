// Schaltflächen und Eingabefelder nach Calino (DESIGN.md: Buttons, Inputs).
// Calino: Copyright (c) 2025 Ivan Malinovski, MIT-Lizenz.

import { Theme } from "theme.slint";

// Fokusring: 2 px Akzent mit 2 px Abstand um ein Element der Größe w × h
export component FocusRing inherits Rectangle {
    in property <length> radius;
    in property <length> w;
    in property <length> h;
    x: -4px;
    y: -4px;
    width: root.w + 8px;
    height: root.h + 8px;
    border-radius: root.radius + 4px;
    border-width: 2px;
    border-color: Theme.accent;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    // Zerstörende Aktion (Löschen): Fehlerfarbe statt Akzent
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    width: label.preferred-width + 32px;
    border-radius: Theme.radius-sm;
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    background: root.primary
        ? (!root.enabled ? Theme.accent.with-alpha(0.5) : ta.pressed ? Theme.accent-strong : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger
        ? (ta.pressed ? Theme.error.with-alpha(0.18) : ta.has-hover ? Theme.error.with-alpha(0.12) : Theme.error-bg)
        : (ta.pressed ? Theme.ink-raw.with-alpha(0.12) : ta.has-hover ? Theme.ink-raw.with-alpha(0.09) : Theme.line);
    animate background { duration: Theme.dur-fast; }

    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        color: root.primary ? Theme.accent-contrast : root.danger ? Theme.error : Theme.ink;
        opacity: root.enabled ? 1 : 0.6;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }

    if fs.has-focus: FocusRing {
        radius: Theme.radius-sm;
        w: root.width;
        h: root.height;
    }
}

// Kleine Symbolschaltfläche (z. B. + in der Seitenleiste)
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> icon-size: 15px;
    callback clicked();

    width: 26px;
    height: 24px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.ink-raw.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    animate background { duration: Theme.dur-fast; }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: ta.has-hover ? Theme.ink : Theme.ink-3;
    }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    if fs.has-focus: FocusRing {
        radius: 6px;
        w: root.width;
        h: root.height;
    }
}

// Eingabefeld: Haarlinie, 4 px Rundung, 10/12 px Innenabstand; Fokus mit
// Akzentrand und 3 px Schein, Fehler in Rot.
export component TextField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback accepted();
    callback edited();

    forward-focus: input;
    spacing: 6px;

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 500;
        color: Theme.ink-2;
    }

    Rectangle {
        height: 38px;

        if input.has-focus: Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: Theme.radius-sm + 3px;
            border-width: 3px;
            border-color: Theme.accent.with-alpha(0.15);
        }

        Rectangle {
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.line;
            background: Theme.input-bg;
            animate border-color { duration: Theme.dur-fast; }
        }

        if root.text == "": Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.placeholder;
            font-size: 14px;
            color: Theme.ink-3;
            vertical-alignment: center;
            overflow: elide;
        }

        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            text <=> root.text;
            enabled: root.enabled;
            input-type: root.password ? InputType.password : InputType.text;
            font-size: 14px;
            color: Theme.ink;
            selection-background-color: Theme.accent.with-alpha(0.3);
            selection-foreground-color: Theme.ink;
            vertical-alignment: center;
            single-line: true;
            accessible-label: root.label;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited();
            }
        }
    }
}
