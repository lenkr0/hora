// Befehlspalette (Strg+K) nach Calinos CommandPalette
// (CommandPalette.module.css): Eingabe oben, Treffer in Gruppen, unten die
// Tastenhinweise. Pfeiltasten wählen, Eingabe führt aus, Esc schließt.
// Calino: Copyright (c) 2025 Ivan Malinovski, MIT-Lizenz.

import { Theme } from "theme.slint";

export struct PaletteItem {
    // Gruppenüberschrift ("NAVIGATION", "TERMINE", …)
    header: bool,
    title: string,
    detail: string,
    // Kalendername rechts
    badge: string,
    badge-color: color,
    // Farbpunkt links (Kalender, Termine, Aufgaben)
    dot: bool,
    // Rund statt gefüllt: Aufgabe
    ring: bool,
    shortcut: string,
    // Eintrag in der Liste der App; -1 bei Überschriften
    id: int,
    // Oberkante in der Liste: Überschrift 30 px, Eintrag 44 px
    y: length,
}

component Keycap inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <angle> turn;

    width: root.has-icon ? 20px : Math.max(20px, label.preferred-width + 10px);
    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.ink-raw.with-alpha(0.03);

    if root.has-icon: Image {
        source: root.icon;
        width: 11px;
        height: 11px;
        colorize: Theme.ink-3;
        transform-rotation: root.turn;
    }

    label := Text {
        visible: !root.has-icon;
        text: root.text;
        font-size: 10.5px;
        font-weight: 500;
        color: Theme.ink-3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CommandPalette inherits Rectangle {
    in property <[PaletteItem]> items;
    in-out property <string> text;
    // Zeile unter der Auswahl
    in-out property <int> selected;
    // Neue Eingabe: Treffer neu suchen
    callback query(string);
    // Zeile ausführen
    callback run(int);
    callback close();

    property <length> content-h: root.items.length == 0 ? 0px
        : root.items[root.items.length - 1].y + (root.items[root.items.length - 1].header ? 30px : 44px) + 8px;
    property <length> list-h: root.items.length == 0 ? 64px : Math.min(400px, root.content-h);

    function move(delta: int) {
        if delta > 0 && root.selected + 1 < root.items.length {
            root.selected = root.items[root.selected + 1].header && root.selected + 2 < root.items.length ? root.selected + 2 : root.selected + 1;
        }
        if delta < 0 && root.selected > 0 {
            root.selected = !root.items[root.selected - 1].header ? root.selected - 1
                : root.selected >= 2 ? root.selected - 2 : root.selected;
        }
        root.reveal();
    }

    // Auswahl sichtbar halten; bei der ersten Zeile einer Gruppe mit Überschrift
    function reveal() {
        if root.selected >= 0 && root.selected < root.items.length {
            if root.items[root.selected].y - (root.selected > 0 && root.items[root.selected - 1].header ? 30px : 0px) < -list.content-y {
                list.content-y = -(root.items[root.selected].y - (root.selected > 0 && root.items[root.selected - 1].header ? 30px : 0px));
            }
            if root.items[root.selected].y + 52px > -list.content-y + list.height {
                list.content-y = -(root.items[root.selected].y + 52px - list.height);
            }
        }
    }

    changed items => {
        list.content-y = 0;
    }

    init => {
        input.focus();
        input.select-all();
    }

    background: Theme.dark ? #00000066 : #00000033;

    // Klick daneben schließt
    TouchArea {
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: 80px;
        width: Math.min(580px, root.width - 32px);
        height: 56px + 1px + root.list-h + 1px + 40px;
        background: Theme.modal-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.popover-border;
        drop-shadow-offset-y: 16px;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.modal-shadow;
        clip: true;

        // Klicks in der Palette nicht an die Abdunklung durchreichen
        TouchArea { }

        keys := FocusScope {
            y: 0px;
            height: 56px;
            capture-key-pressed(e) => {
                if e.text == Key.DownArrow || (e.text == Key.Tab && !e.modifiers.shift) {
                    root.move(1);
                    return accept;
                }
                if e.text == Key.UpArrow || e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) {
                    root.move(-1);
                    return accept;
                }
                if e.text == Key.Return {
                    if root.selected >= 0 && root.selected < root.items.length && !root.items[root.selected].header {
                        root.run(root.selected);
                    }
                    return accept;
                }
                if e.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }

            Image {
                x: 18px;
                width: 17px;
                height: 17px;
                source: @image-url("icons/search.svg");
                colorize: Theme.ink-3;
            }

            input := TextInput {
                x: 48px;
                width: parent.width - 64px;
                height: parent.height;
                vertical-alignment: center;
                font-size: 16px;
                color: Theme.ink;
                single-line: true;
                text <=> root.text;
                selection-background-color: Theme.accent.with-alpha(0.3);
                selection-foreground-color: Theme.ink;
                accessible-label: "Suchen oder Befehl eingeben";
                edited => {
                    root.query(self.text);
                }
            }

            if input.text == "": Text {
                x: 48px;
                height: parent.height;
                text: "Suchen, Befehl oder z. B. „Zahnarzt morgen 15 Uhr“";
                font-size: 16px;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }

        Rectangle {
            y: 56px;
            height: 1px;
            background: Theme.line;
        }

        list := Flickable {
            y: 57px;
            height: root.list-h;
            content-height: root.content-h;

            for item[i] in root.items: Rectangle {
                x: 6px;
                y: item.y;
                width: list.width - 12px;
                height: item.header ? 30px : 44px;
                border-radius: Theme.radius-md;
                background: item.header ? transparent
                    : i == root.selected ? Theme.selected-bg
                    : row-ta.has-hover ? Theme.hover-bg : transparent;
                accessible-role: list-item;
                accessible-label: item.title + (item.detail != "" ? ", " + item.detail : "") + (item.badge != "" ? ", " + item.badge : "");
                accessible-item-selected: i == root.selected;

                if item.header: Text {
                    x: 10px;
                    y: 12px;
                    height: 18px;
                    text: item.title;
                    font-size: 10.5px;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }

                if !item.header: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 10px;

                    if item.dot: VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: item.ring ? 4.5px : 2.5px;
                            border-width: item.ring ? 1.5px : 0px;
                            border-color: item.badge-color;
                            background: item.ring ? transparent : item.badge-color;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;

                        Text {
                            text: item.title;
                            font-size: 14px;
                            font-weight: i == root.selected ? 500 : 400;
                            color: Theme.ink;
                            overflow: elide;
                        }

                        if item.detail != "": Text {
                            text: item.detail;
                            font-size: 12px;
                            color: Theme.ink-3;
                            overflow: elide;
                        }
                    }

                    if item.badge != "": VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: Math.min(160px, badge-text.preferred-width + 14px);
                            height: 20px;
                            border-radius: 10px;
                            background: Theme.ink-raw.with-alpha(0.05);

                            badge-text := Text {
                                x: 7px;
                                width: parent.width - 14px;
                                text: item.badge;
                                font-size: 11.5px;
                                color: Theme.ink-2;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if item.shortcut != "": VerticalLayout {
                        alignment: center;

                        Keycap {
                            text: item.shortcut;
                        }
                    }
                }

                row-ta := TouchArea {
                    enabled: !item.header;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.selected = i;
                        root.run(i);
                    }
                }
            }

            if root.items.length == 0: Text {
                width: list.width;
                height: 64px;
                text: "Keine Treffer";
                font-size: 13.5px;
                color: Theme.ink-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            y: 57px + root.list-h;
            height: 1px;
            background: Theme.line;
        }

        // Tastenhinweise (Calino: footer)
        HorizontalLayout {
            y: 58px + root.list-h;
            height: 40px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;

                Keycap {
                    has-icon: true;
                    icon: @image-url("icons/chevron-down.svg");
                    turn: 180deg;
                }
            }

            VerticalLayout {
                alignment: center;

                Keycap {
                    has-icon: true;
                    icon: @image-url("icons/chevron-down.svg");
                }
            }

            Text {
                text: "Navigieren";
                font-size: 12px;
                color: Theme.ink-3;
                vertical-alignment: center;
            }

            Rectangle {
                width: 12px;
            }

            VerticalLayout {
                alignment: center;

                Keycap {
                    text: "Eingabe";
                }
            }

            Text {
                text: "Auswählen";
                font-size: 12px;
                color: Theme.ink-3;
                vertical-alignment: center;
            }

            Rectangle {
                width: 12px;
            }

            VerticalLayout {
                alignment: center;

                Keycap {
                    text: "Esc";
                }
            }

            Text {
                text: "Schließen";
                font-size: 12px;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
    }
}
