// Datumsfeld: Eingabe wie bisher, dazu rechts ein Kalendersymbol, das ein
// Monatsblatt zum Auswählen öffnet.

import { Theme } from "theme.slint";
import { TextField } from "controls.slint";
import { MiniCalendar, MiniDay } from "mini-calendar.slint";

// Monatsblatt der Datumsauswahl. Rust füllt es beim Öffnen; es ist immer
// höchstens eine Auswahl offen.
export global DatePick {
    in property <string> month;
    in property <string> year;
    in property <[MiniDay]> days;
    // Tag unter dem Tastaturfokus (Index in `days`)
    in property <int> cursor: -1;
    // Text im Feld: Dieser Tag ist gewählt, sonst heute
    callback open(string);
    // Monate vor (+) oder zurück (-)
    callback shift(int);
    // Tastaturfokus um Tage verschieben
    callback move(int);
    // Tag (Index in `days`) als Text fürs Feld
    callback pick(int) -> string;
}

export component DateField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback accepted();

    forward-focus: field;

    field := TextField {
        label: root.label;
        placeholder: root.placeholder;
        enabled: root.enabled;
        text <=> root.text;
        action-icon: @image-url("icons/calendar.svg");
        action-label: root.enabled ? @tr("Choose date") : "";
        accepted => {
            root.accepted();
        }
        action => {
            DatePick.open(root.text);
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 268px;
        height: sheet.height;

        sheet := MiniCalendar {
            width: parent.width;
            month: DatePick.month;
            year: DatePick.year;
            days: DatePick.days;
            cursor: DatePick.cursor;
            background: Theme.popover-bg;
            border-color: Theme.popover-border;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.dark ? transparent : #0000001a;
            prev => {
                DatePick.shift(-1);
            }
            next => {
                DatePick.shift(1);
            }
            pick(i) => {
                root.text = DatePick.pick(i);
                popup.close();
                field.focus();
            }

            // Pfeiltasten wandern über die Tage, Bild auf/ab blättert,
            // Eingabe übernimmt, Esc schließt
            keys := FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                init => {
                    self.focus();
                }
                key-pressed(e) => {
                    if e.text == Key.LeftArrow {
                        DatePick.move(-1);
                    } else if e.text == Key.RightArrow {
                        DatePick.move(1);
                    } else if e.text == Key.UpArrow {
                        DatePick.move(-7);
                    } else if e.text == Key.DownArrow {
                        DatePick.move(7);
                    } else if e.text == Key.PageUp {
                        DatePick.shift(-1);
                    } else if e.text == Key.PageDown {
                        DatePick.shift(1);
                    } else if e.text == Key.Return || e.text == " " {
                        root.text = DatePick.pick(DatePick.cursor);
                        popup.close();
                        field.focus();
                    } else if e.text == Key.Escape {
                        popup.close();
                        field.focus();
                    } else {
                        return reject;
                    }
                    return accept;
                }
            }
        }
    }
}
